{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tr724/headlines",
	"title": "Günün Manşetleri",
	"category": "theme",
	"description": "Today's headlines as a swipeable carousel. Shown under the patron box on editor and administrator posts.",
	"keywords": [ "carousel", "swiper", "headline", "manset", "günün" ],
	"textdomain": "tr724-news",
	"attributes": {
		"postsToShow": {
			"type": "number",
			"default": 15
		},
		"categoryId": {
			"type": "number",
			"default": 13694
		},
		"excludeId": {
			"type": "number",
			"default": 0
		}
	},
	"supports": {
		"html": false,
		"align": false,
		"color": false,
		"typography": false,
		"spacing": false
	},
	"render": "file:./render.php",
	"style": [ "tr724-swiper", "tr724-news-inter", "file:./style.css" ],
	"editorStyle": "file:./editor.css",
	"editorScript": "file:./edit.js",
	"script": "file:./view.js"
}
