{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tr724/spotlight",
	"title": "Spotlight",
	"category": "theme",
	"description": "Manşet carousel. Shows the latest posts, optionally from one category.",
	"keywords": [ "carousel", "swiper", "headline", "manset" ],
	"textdomain": "tr724-news",
	"attributes": {
		"categoryId": {
			"type": "number",
			"default": 0
		},
		"postsToShow": {
			"type": "number",
			"default": 15
		},
		"moreUrl": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": false,
		"color": false,
		"typography": false,
		"spacing": false
	},
	"render": "file:./render.php",
	"style": [ "tr724-swiper", "tr724-news-inter", "file:./style.css" ],
	"editorStyle": "file:./editor.css",
	"editorScript": "file:./edit.js",
	"script": "file:./view.js"
}
