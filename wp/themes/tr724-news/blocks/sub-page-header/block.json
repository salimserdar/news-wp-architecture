{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tr724/sub-page-header",
	"title": "Sub Page Header",
	"category": "theme",
	"description": "Watermark heading for a sub page. Same header as a category archive.",
	"keywords": [ "header", "heading", "watermark", "category", "başlık" ],
	"textdomain": "tr724-news",
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"watermark": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": false,
		"color": false,
		"typography": false,
		"spacing": false
	},
	"render": "file:./render.php",
	"style": [ "tr724-news-inter", "file:./style.css" ],
	"editorStyle": "file:./editor.css",
	"editorScript": "file:./edit.js"
}
