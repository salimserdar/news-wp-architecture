{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tr724/timeline",
	"title": "Timeline",
	"category": "theme",
	"description": "Yayın Akışı. YouTube programs with time and name in a horizontal row. Managed in Editorial → Timeline.",
	"keywords": [ "timeline", "schedule", "youtube", "yayın", "akış", "program" ],
	"textdomain": "tr724-news",
	"attributes": {
		"anchor": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": false,
		"color": false,
		"typography": false,
		"spacing": false,
		"customClassName": true
	},
	"render": "file:./render.php",
	"style": [ "tr724-news-inter", "file:./style.css" ],
	"editorStyle": "file:./editor.css",
	"editorScript": "file:./edit.js"
}
