{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tr724/videos",
	"title": "Videos",
	"category": "theme",
	"description": "YouTube video carousel. Loads the latest videos from the site aggregator.",
	"keywords": [ "video", "youtube", "carousel", "swiper" ],
	"textdomain": "tr724-news",
	"attributes": {
		"videosToShow": {
			"type": "number",
			"default": 10
		},
		"allLabel": {
			"type": "string",
			"default": "Tüm Videolar"
		},
		"allUrl": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": false,
		"color": false,
		"typography": false,
		"spacing": false
	},
	"render": "file:./render.php",
	"style": [ "tr724-swiper", "tr724-news-inter", "file:./style.css" ],
	"editorStyle": "file:./editor.css",
	"editorScript": "file:./edit.js",
	"script": "file:./view.js"
}
