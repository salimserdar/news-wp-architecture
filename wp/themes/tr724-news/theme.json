{
	"$schema": "https://schemas.wp.org/wp/6.4/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "1040px",
			"wideSize": "1040px"
		},
		"color": {
			"palette": [
				{
					"slug": "brand",
					"color": "#003399",
					"name": "Brand"
				}
			]
		},
		"blocks": {
			"core/paragraph": {
				"typography": {
					"customFontSize": false,
					"defaultFontSizes": false,
					"fontSizes": []
				}
			}
		}
	},
	"styles": {
		"blocks": {
			"core/paragraph": {
				"typography": {
					"fontSize": "18px"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
