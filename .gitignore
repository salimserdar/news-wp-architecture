# Secrets
.env

# Runtime data (site tree, DB dumps, media, backups, logs)
wordpress/
import/*
!import/.gitkeep
backups/*
!backups/.gitkeep
logs/*
!logs/.gitkeep

# TLS material
config/nginx/certs/*
!config/nginx/certs/.gitkeep
!config/nginx/certs/README.md

# Load-test artefacts generated on the VPS / generator
loadtest/urls.json
loadtest/results/*
!loadtest/results/.gitkeep

# OS / editor
.DS_Store
*.swp
