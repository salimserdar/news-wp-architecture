# Copy to .env and fill in.   cp .env.example .env
# Never commit .env.

# --- Site -------------------------------------------------------------------
SITE_DOMAIN=www.example.com          # canonical host, no scheme, no trailing slash

# --- Database ---------------------------------------------------------------
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=change-me-long-random
DB_ROOT_PASSWORD=change-me-too-long-random
# Table prefix used by the DB you are importing (check your old wp-config.php)
DB_TABLE_PREFIX=wp_

# --- Cloudflare (for purge-on-publish; leave empty to disable edge purging) --
# API token with permission:  Zone > Cache Purge > Purge   (scoped to this zone)
CF_ZONE_ID=
CF_API_TOKEN=

# --- Resource limits (defaults sized for 8 vCPU / 32 GB; see docs/04) --------
# Lower these on a smaller machine or for local testing.
#NGINX_CPUS=2       NGINX_MEM=1g
#PHP_CPUS=5         PHP_MEM=5g
#PHP_ADMIN_CPUS=2   PHP_ADMIN_MEM=2g
#DB_CPUS=4          DB_MEM=11g        DB_BUFFER_POOL=8G
#REDIS_CPUS=1       REDIS_MEM=2560m
#CRON_CPUS=1        CRON_MEM=512m

# --- Backups (scripts/backup.sh) ---------------------------------------------
BACKUP_KEEP_DAYS=14
# rclone remote for offsite copies, e.g. r2:news-backups (leave empty to skip)
BACKUP_RCLONE_REMOTE=
