# Copy to .env and fill in.   cp .env.example .env
# Never commit .env.

# --- Site -------------------------------------------------------------------
SITE_DOMAIN=www.example.com          # canonical host, no scheme, no trailing slash
WP_ROOT=/var/www/html                # WordPress tree on the VPS

# --- Database ---------------------------------------------------------------
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=change-me-long-random
# Table prefix used by the DB you are importing (check your old wp-config.php)
DB_TABLE_PREFIX=wp_
# InnoDB buffer pool. Default scales with RAM (8G on a 32 GB box).
#DB_BUFFER_POOL=8G

# --- PHP-FPM ----------------------------------------------------------------
# Public cache misses + editors share one pool. Default 20.
#PHP_MAX_CHILDREN=20

# --- Cloudflare (for purge-on-publish; leave empty to disable edge purging) --
# API token with permission:  Zone > Cache Purge > Purge   (scoped to this zone)
CF_ZONE_ID=
CF_API_TOKEN=

# --- Database backups (R2) ---------------------------------------------------
# One private bucket. Each UTC day is a folder: news-db/YYYYMMDD/dump.sql.zst
# Bucket lock: a dump can be written, then not deleted or overwritten.
# Writer key: Object Read & Write on this bucket only. Not the media key.
# Admin token stays on the laptop that runs scripts/r2-db-backup.sh. Never on the VPS.
BACKUP_KEEP_DAYS=14
R2_DB_BUCKET=news-db
# Empty = lock forever. A number = keep each dump that many days, then an admin
# may remove it. The VPS still cannot delete it.
#R2_DB_RETENTION_DAYS=
# Laptop only, not the VPS .env:
#R2_BACKUP_ADMIN_TOKEN=
# VPS only, written by provision into backups/r2-db-writer.env:
R2_DB_ACCESS_KEY_ID=
R2_DB_SECRET_ACCESS_KEY=

# Legacy import pull (scripts/pull-gcs-backup.sh). Not the nightly backup.
GCS_BUCKET=tr724-backup
GCS_DB_OBJECT=db/wp_tr724.sql
GCS_WP_CONTENT=wp-content
# Optional gcsfuse mount point (scripts/gcs.sh mount). Not for MariaDB or live uploads.
GCS_MOUNT=/mnt/gcs
# rclone remote name created by scripts/gcs.sh rclone-config (env_auth, no JSON key)
GCS_RCLONE_REMOTE=gcs

# --- R2 media offload (docs/07-media-offload.md) -----------------------------
# Separate from R2_DB_ACCESS_KEY_ID. Public media bucket only.
# S3 API token: Object Read & Write on this bucket. Never commit real values.
# scripts/setup-vps.sh copies non-empty values into wp-config.php as NEWS_R2_*.
# r2-offload.php does nothing until all four are set.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=news-media
# Public origin for /wp-content/uploads/ (mu-plugin media-urls.php).
# Scheme + host, no path, no trailing slash. Empty keeps the plugin default.
MEDIA_URL=https://media.turkishnote.com

# --- GCE VM (scripts/create-gce-vm.sh, run from your laptop) ----------------
# GCE_NAME=news-wp-2                 # must be unused; news-wp already exists in this project
# GCE_ZONE=europe-west1-b
# GCE_MACHINE=e2-highmem-2          # 2 vCPU / 16 GB; e2-standard-2 = 2 vCPU / 8 GB
# GCE_DISK_GB=300
# GCE_DISK_TYPE=pd-standard         # pd-balanced/pd-ssd count against SSD quota (500 GB in us-central1)
# GCE_SA=                           # empty = default Compute Engine service account

# --- Aggregator on the VPS (not Docker, not wp-config.php) -------------------
# setup-vps.sh copies non-empty values into /etc/news-wp/aggregator.env
# (root:www-data, mode 0640) when that file's keys are still empty.
# Also copy the aggregator certificate to /etc/nginx/ssl/site-aggregator.crt.
# That file is only the trust anchor. It is not this site's public certificate.
# AGGREGATOR_IP=
# SYNC_TOKEN=
# READ_TOKEN=

# --- Local Docker (docker-compose.yml only; not used on the VPS) ------------
# Compose interpolates these into the wordpress service. It does not load this
# whole file into the container.
SITE_AGGREGATOR_SERVICE_URL=http://host.docker.internal:3000
SITE_AGGREGATOR_READ_API_KEY=
# Bearer token for POST /api/v1/sync/posts and POST /api/v1/sync/media.
SITE_AGGREGATOR_SYNC_TOKEN=
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

