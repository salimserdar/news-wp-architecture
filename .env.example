# Copy to .env and fill in.   cp .env.example .env
# Never commit .env.

# --- Site -------------------------------------------------------------------
SITE_DOMAIN=www.example.com          # canonical host, no scheme, no trailing slash
WP_ROOT=/var/www/html                # WordPress tree on the VPS

# --- Database ---------------------------------------------------------------
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=change-me-long-random
# Table prefix used by the DB you are importing (check your old wp-config.php)
DB_TABLE_PREFIX=wp_
# InnoDB buffer pool. Default scales with RAM (8G on a 32 GB box).
#DB_BUFFER_POOL=8G

# --- PHP-FPM ----------------------------------------------------------------
# Public cache misses + editors share one pool. Default 20.
#PHP_MAX_CHILDREN=20

# --- Cloudflare (for purge-on-publish; leave empty to disable edge purging) --
# API token with permission:  Zone > Cache Purge > Purge   (scoped to this zone)
CF_ZONE_ID=
CF_API_TOKEN=

# --- Backups (scripts/backup.sh) ---------------------------------------------
BACKUP_KEEP_DAYS=14
# rclone remote for offsite copies, e.g. r2:news-backups (leave empty to skip)
BACKUP_RCLONE_REMOTE=
# Cloud Storage bucket that holds the site backup (no JSON key — GCE service account).
# Layout: gs://tr724-backup/db/wp_tr724.sql  and  gs://tr724-backup/wp-content/
GCS_BUCKET=tr724-backup
GCS_DB_OBJECT=db/wp_tr724.sql
GCS_WP_CONTENT=wp-content
# Optional gcsfuse mount point (scripts/gcs.sh mount). Not for MariaDB or live uploads.
GCS_MOUNT=/mnt/gcs
# rclone remote name created by scripts/gcs.sh rclone-config (env_auth, no JSON key)
GCS_RCLONE_REMOTE=gcs

# --- GCE VM (scripts/create-gce-vm.sh, run from your laptop) ----------------
# GCE_NAME=news-wp-2                 # must be unused; news-wp already exists in this project
# GCE_ZONE=europe-west1-b
# GCE_MACHINE=e2-highmem-2          # 2 vCPU / 16 GB; e2-standard-2 = 2 vCPU / 8 GB
# GCE_DISK_GB=100
# GCE_DISK_TYPE=pd-standard         # pd-balanced/pd-ssd count against SSD quota (500 GB in us-central1)
# GCE_SA=                           # empty = default Compute Engine service account

